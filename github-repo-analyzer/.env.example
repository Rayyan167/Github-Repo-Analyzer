# Copy this file to .env and fill in your own values.
# .env is loaded automatically by config/settings.py — never commit it.

# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL database
DB_NAME=repo_analyzer
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# GitHub API (optional).
# Without a token, GitHub allows 60 unauthenticated requests/hour per IP.
# With a personal access token (no special scopes needed for public repos),
# the limit rises to 5,000 requests/hour.
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=
